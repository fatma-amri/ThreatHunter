# ─────────────────────────────────────────────────────────────
#  ThreatHunter — variables d'environnement (copier en .env)
#  Le fichier .env est ignore par git (.gitignore).
# ─────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/
DB_NAME=threathunter

# ── MISP (CTI) ───────────────────────────────────────────────
MISP_URL=https://192.168.100.20
MISP_KEY=

# ── Authentification du dashboard (compte admin unique) ──────
# NE JAMAIS mettre le mot de passe en clair : seul le hash bcrypt est stocke.
# Generer / mettre a jour :
#     python -m dashboard.pages.auth --create-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
